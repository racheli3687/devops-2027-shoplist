# בחירת תבנית בסיס (Image) של פייתון בגרסה מדויקת ומעודכנת
FROM python:3.11-slim

# הגדרת תיקיית העבודה הראשית בתוך הקונטיינר
WORKDIR /app

# העתקת קובץ הדרישות (קובץ התלויות) אל תיקיית העבודה
COPY requirements.txt .

# התקנת כל הספריות הנדרשות לפני העתקת קוד המקור כדי לנצל את מנגנון ה-Cache של דוקר
RUN pip install --no-cache-dir -r requirements.txt

# העתקת כל שאר קבצי הקוד מהמחשב אל תוך הקונטיינר
COPY . .

# פתיחת הפורט שבו השרת מאזין לתעבורה נכנסת
EXPOSE 8000

# הגדרת פקודת ההפעלה של השרת בצורת exec (עם סוגריים מרובעים)
CMD ["python", "app.py"]
